# ─────── Python artifacts ───────
# Virtual environments
.venv/
env/
venv/

# Byte‐compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# SQLite database (Django default, or similar)
*.sqlite3

# Django migrations (optional—if you commit them you can remove this)
# **/migrations/
# **/migrations/*.py
# **/migrations/*.py[co]

# ─────── Node / JavaScript artifacts ───────
# Node modules (for any nested backend/frontend)
node_modules/
**/node_modules/

# Build folders (CRA, Next.js, etc.)
build/
dist/
 `.next`/
out/

# Package‐lock (if you prefer yarn.lock instead)
package-lock.json
yarn.lock
.pnpm‐lock.yaml

# Yarn v2+ PnP artifacts
.pnp
.pnp.js

# ─────── Environment / Config ───────
# dotenv environment files
.env
.env.*
!.env.example

# Vercel / Netlify
.vercel/
.netlify/
firebase.json

# macOS Finder metadata
.DS_Store

# Logs and debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Coverage reports
coverage/
**/coverage/

# IDE / Editor folders (optional: add your own)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Miscellaneous
*.bak
*.tmp
